
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('python-flask-app') {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                        python3 -m venv venv
                        venv/bin/python -m pip install --upgrade pip
                        venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('python-flask-app') {
                    echo 'Running unit tests...'
                    sh '''
                        venv/bin/python -m unittest discover -s . -p "test_*.py"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('python-flask-app') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p "$WORKSPACE/python-app-deploy"
                        cp app.py "$WORKSPACE/python-app-deploy/"
                        cp requirements.txt "$WORKSPACE/python-app-deploy/"
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    nohup "$WORKSPACE/python-flask-app/venv/bin/python" \
                        "$WORKSPACE/python-app-deploy/app.py" \
                        > "$WORKSPACE/python-app-deploy/app.log" 2>&1 &

                    echo $! > "$WORKSPACE/python-app-deploy/app.pid"

                    for i in $(seq 1 15); do
                        if curl -fsS http://127.0.0.1:5000/ >/dev/null; then
                            echo "Application started successfully."
                            exit 0
                        fi
                        sleep 1
                    done

                    echo "Application failed to start."
                    cat "$WORKSPACE/python-app-deploy/app.log"
                    exit 1
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing deployed application...'
                sh '''
                    curl -fsS http://127.0.0.1:5000/
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
        always {
            sh '''
                if [ -f "$WORKSPACE/python-app-deploy/app.pid" ]; then
                    kill "$(cat "$WORKSPACE/python-app-deploy/app.pid")" 2>/dev/null || true
                fi
            '''
        }
    }
}
